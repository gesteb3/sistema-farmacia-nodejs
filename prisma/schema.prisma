generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Medication {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(30)
  name                 String   @db.VarChar(120)
  activeIngredient     String   @map("active_ingredient") @db.VarChar(120)
  presentation         String   @db.VarChar(80)
  concentration        String?  @db.VarChar(60)
  purchasePrice        Decimal  @map("purchase_price") @db.Decimal(12, 2)
  salePrice            Decimal  @map("sale_price") @db.Decimal(12, 2)
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  batches              InventoryBatch[]
  purchaseItems        PurchaseItem[]

  @@index([name])
  @@map("medications")
}

model InventoryBatch {
  id             String              @id @default(uuid()) @db.Uuid
  medicationId   String              @map("medication_id") @db.Uuid
  batchNumber    String              @map("batch_number") @db.VarChar(50)
  expirationDate DateTime            @map("expiration_date") @db.Date
  stock          Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  medication     Medication          @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]

  @@unique([medicationId, batchNumber])
  @@index([expirationDate])
  @@map("inventory_batches")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @map("batch_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  previousStock Int                   @map("previous_stock")
  newStock      Int                   @map("new_stock")
  reason        String                @db.VarChar(200)
  createdAt     DateTime              @default(now()) @map("created_at")
  batch         InventoryBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@map("inventory_movements")
}

enum InventoryMovementType {
  ENTRY
  EXIT
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  nit         String   @unique @db.VarChar(20)
  name        String   @db.VarChar(120)
  contactName String?  @map("contact_name") @db.VarChar(120)
  phone       String?  @db.VarChar(25)
  email       String?  @db.VarChar(150)
  address     String?  @db.VarChar(250)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  purchases   Purchase[]

  @@index([name])
  @@map("suppliers")
}

model Purchase {
  id            String         @id @default(uuid()) @db.Uuid
  supplierId    String         @map("supplier_id") @db.Uuid
  invoiceNumber String         @map("invoice_number") @db.VarChar(50)
  purchaseDate  DateTime       @map("purchase_date") @db.Date
  total         Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at")
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id           String         @id @default(uuid()) @db.Uuid
  purchaseId   String         @map("purchase_id") @db.Uuid
  medicationId String         @map("medication_id") @db.Uuid
  batchId      String         @map("batch_id") @db.Uuid
  quantity     Int
  unitCost     Decimal        @map("unit_cost") @db.Decimal(12, 2)
  subtotal     Decimal        @db.Decimal(12, 2)
  purchase     Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  medication   Medication     @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  batch        InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  nit       String?  @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  phone     String?  @db.VarChar(25)
  email     String?  @db.VarChar(150)
  address   String?  @db.VarChar(250)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("customers")
}
