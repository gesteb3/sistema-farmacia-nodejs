generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Medication {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(30)
  name                 String   @db.VarChar(120)
  activeIngredient     String   @map("active_ingredient") @db.VarChar(120)
  presentation         String   @db.VarChar(80)
  concentration        String?  @db.VarChar(60)
  purchasePrice        Decimal  @map("purchase_price") @db.Decimal(12, 2)
  salePrice            Decimal  @map("sale_price") @db.Decimal(12, 2)
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  batches              InventoryBatch[]

  @@index([name])
  @@map("medications")
}

model InventoryBatch {
  id             String              @id @default(uuid()) @db.Uuid
  medicationId   String              @map("medication_id") @db.Uuid
  batchNumber    String              @map("batch_number") @db.VarChar(50)
  expirationDate DateTime            @map("expiration_date") @db.Date
  stock          Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  medication     Medication          @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  movements      InventoryMovement[]

  @@unique([medicationId, batchNumber])
  @@index([expirationDate])
  @@map("inventory_batches")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @map("batch_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  previousStock Int                   @map("previous_stock")
  newStock      Int                   @map("new_stock")
  reason        String                @db.VarChar(200)
  createdAt     DateTime              @default(now()) @map("created_at")
  batch         InventoryBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@map("inventory_movements")
}

enum InventoryMovementType {
  ENTRY
  EXIT
}
