generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Medication {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(30)
  name                 String   @db.VarChar(120)
  activeIngredient     String   @map("active_ingredient") @db.VarChar(120)
  presentation         String   @db.VarChar(80)
  concentration        String?  @db.VarChar(60)
  purchasePrice        Decimal  @map("purchase_price") @db.Decimal(12, 2)
  salePrice            Decimal  @map("sale_price") @db.Decimal(12, 2)
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("medications")
}
